%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c4698d1a69794f311b7c9686fa1eb9c6, type: 3}
  m_Name: LocalizationTable
  m_EditorClassIdentifier: SaksiTerakhir.Runtime::SaksiTerakhir.Localization.LocalizationTable
  defaultLanguage: 1
  entries:
  - key: interact.generic
    english: Interact
    indonesian: Berinteraksi
  - key: interact.door.open
    english: Open Door
    indonesian: Buka Pintu
  - key: interact.door.close
    english: Close Door
    indonesian: Tutup Pintu
  - key: interact.door.locked
    english: Locked
    indonesian: Terkunci
  - key: interact.npc.talk
    english: Talk to {0}
    indonesian: Bicara dengan {0}
  - key: interact.npc.make_space
    english: Make a little room so we can talk.
    indonesian: Beri sedikit ruang agar bisa berbicara.
  - key: interact.story.find_both
    english: Find Raka and Sinta
    indonesian: Temukan Raka dan Sinta
  - key: interact.story.find_raka
    english: Find Raka
    indonesian: Temukan Raka
  - key: interact.story.find_sinta
    english: Find Sinta
    indonesian: Temukan Sinta
  - key: interact.story.wait_colleagues
    english: Wait for your colleagues
    indonesian: Tunggu rekan-rekan
  - key: interact.story.wait_boss
    english: Wait for Arya's call
    indonesian: Tunggu panggilan Arya
  - key: story.quest.started
    english: New main quest
    indonesian: Misi utama dimulai
  - key: story.quest.updated
    english: Main quest updated
    indonesian: Misi utama diperbarui
  - key: story.call.incoming
    english: 'Incoming call: Arya. Press E to answer.'
    indonesian: 'Panggilan masuk: Arya. Tekan E untuk menjawab.'
  - key: quest.main.rooftop
    english: Lunch Break
    indonesian: Jam Istirahat
  - key: quest.main.rooftop.talk
    english: Meet your colleagues on the rooftop
    indonesian: Temui rekan kerja di rooftop
  - key: quest.main.call
    english: An Unexpected Call
    indonesian: Panggilan Mendadak
  - key: quest.main.call.answer
    english: Press E to answer
    indonesian: Tekan E untuk menjawab
  - key: quest.main.boss_first
    english: An Unexpected Call
    indonesian: Panggilan Mendadak
  - key: quest.main.boss_first.talk
    english: Visit the boss on floor 3
    indonesian: Pergi ke ruangan bos di lantai 3
  - key: quest.main.find
    english: Find A and B
    indonesian: Cari A dan B
  - key: quest.main.find.raka
    english: Find colleague A (Raka)
    indonesian: Cari Rekan A (Raka)
  - key: quest.main.find.sinta
    english: Find colleague B (Sinta)
    indonesian: Cari Rekan B (Sinta)
  - key: quest.main.escort
    english: Follow your colleague to Arya
    indonesian: Ikuti rekanmu ke ruang bos
  - key: quest.main.boss_final
    english: Listen to Arya's briefing
    indonesian: Dengarkan pengarahan Bos Arya
  - key: quest.main.boss_final.listen
    english: Listen to the archive briefing
    indonesian: Dengarkan briefing arsip Wanaseta
  - key: quest.main.key
    english: Field Preparations
    indonesian: Persiapan Lapangan
  - key: quest.main.key.collect
    english: Collect the office car key at reception
    indonesian: Ambil kunci mobil dinas di resepsionis
  - key: quest.main.vehicle
    english: Departure
    indonesian: Keberangkatan
  - key: quest.main.vehicle.reach
    english: Go to the office car
    indonesian: Pergi ke mobil dinas
  - key: item.battery_18650.name
    english: 18650 Lithium-ion Battery
    indonesian: Baterai Litium-ion 18650
  - key: item.battery_18650.description
    english: A blue-wrapped 18650 battery cell labelled 3.7 V and 2200 mAh.
    indonesian: Sel baterai 18650 berlapis biru dengan label 3,7 V dan 2200 mAh.
  - key: item.agenda_book.name
    english: A5 Planner
    indonesian: Buku Agenda A5
  - key: item.agenda_book.description
    english: An A5 planner with a blue leather cover and 80 sheets of lined cream
      paper.
    indonesian: Buku agenda A5 bersampul kulit biru dengan 80 lembar kertas krem
      bergaris.
  - key: item.flashlight.name
    english: Flashlight
    indonesian: Senter
  - key: item.flashlight.description
    english: A cylindrical handheld flashlight with a wrist strap.
    indonesian: Senter genggam berbadan silinder dengan tali gantung.
  - key: item.first_aid_kit.name
    english: First Aid Case
    indonesian: Kotak P3K
  - key: item.first_aid_kit.description
    english: A white vinyl first aid case with a red cross and two metal fasteners.
    indonesian: Kotak P3K vinil putih dengan lambang palang merah dan dua kancing
      logam.
  - key: item.nasi_uduk.name
    english: Wrapped Nasi Uduk
    indonesian: Nasi Uduk Bungkus
  - key: item.nasi_uduk.description
    english: A portion of nasi uduk wrapped in kraft paper with a green leaf band.
    indonesian: Sebungkus nasi uduk dalam kertas kraft dengan pita daun hijau.
  - key: item.power_bank.name
    english: Power Bank
    indonesian: Powerbank
  - key: item.power_bank.description
    english: A slim power bank with two USB-A ports, one USB-C port, and a USB-A
      to USB-C cable.
    indonesian: Powerbank tipis dengan dua port USB-A, satu port USB-C, dan kabel
      USB-A ke USB-C.
  - key: item.car_key.name
    english: Car Key
    indonesian: Kunci Mobil
  - key: item.car_key.description
    english: A car key remote with an emergency key and a small leather pouch.
    indonesian: Remote kunci mobil dengan kunci darurat dan dompet kulit kecil.
  - key: item.nylon_rope_10m.name
    english: 10 m Nylon Rope
    indonesian: Tali Nilon 10 m
  - key: item.nylon_rope_10m.description
    english: A coil of green nylon rope with red flecks, measuring 10 metres long
      and 8 mm in diameter.
    indonesian: Gulungan tali nilon hijau berbintik merah sepanjang 10 meter dengan
      diameter 8 mm.
  - key: item.fiber_rope_10m.name
    english: 10 m Fibre Rope
    indonesian: Tali Tambang 10 m
  - key: item.fiber_rope_10m.description
    english: A coil of cream natural-fibre rope, measuring 10 metres long and 12
      mm in diameter.
    indonesian: Gulungan tali tambang serat alami berwarna krem sepanjang 10 meter
      dengan diameter 12 mm.
  - key: inventory.action.use
    english: Use
    indonesian: Gunakan
  - key: inventory.action.hold
    english: Hold
    indonesian: Pegang
  - key: inventory.action.release
    english: Release
    indonesian: Lepas
  - key: inventory.action.drop
    english: Drop
    indonesian: Buang
  - key: inventory.type.item
    english: Item
    indonesian: Barang
  - key: inventory.type.document
    english: Document
    indonesian: Dokumen
  - key: inventory.full
    english: Inventory is full. Free a slot first.
    indonesian: Inventory penuh. Kosongkan satu slot terlebih dahulu.
  - key: inventory.cannot_use_yet
    english: This item cannot be used here yet.
    indonesian: Barang ini belum bisa digunakan di sini.
  - key: inventory.drop_failed
    english: This item could not be dropped.
    indonesian: Barang ini belum bisa dibuang.
  - key: inventory.required_item_missing
    english: You do not have the required item.
    indonesian: Kamu belum memiliki barang yang dibutuhkan.
  - key: inventory.wrong_item
    english: This item does not work here.
    indonesian: Barang ini tidak cocok untuk digunakan di sini.
  - key: inventory.unavailable
    english: Inventory is unavailable.
    indonesian: Inventory belum tersedia.
  - key: interact.item.pickup
    english: Pick up {0}
    indonesian: Ambil {0}
  - key: interact.item.use
    english: Use {0}
    indonesian: Gunakan {0}
  - key: quest.side.wrong_route
    english: Wrong Route
    indonesian: Salah Jalur
  - key: quest.side.wrong_route.talk
    english: Deliver the file to digitization
    indonesian: Antar berkas ke ruang digitalisasi
  - key: quest.optional.shared_meal
    english: Have a Meal with A and B
    indonesian: Makan Bersama A dan B
  - key: quest.optional.shared_meal.talk
    english: Sit with A and B before collecting the key
    indonesian: Duduk bersama A dan B sebelum mengambil kunci
  - key: quest.optional.desk_preparation
    english: Before You Leave
    indonesian: Sebelum Pergi
  - key: quest.optional.desk_preparation.finish
    english: Tidy the desk before leaving
    indonesian: Rapikan meja sebelum pergi
  - key: quest.optional.supplies
    english: Field Supplies
    indonesian: Perbekalan Lapangan
  - key: quest.optional.supplies.buy
    english: Buy the supplies you need
    indonesian: Beli perbekalan yang dibutuhkan
  - key: document.wanaseta_original.name
    english: Cikapohon Inscription
    indonesian: Prasasti Cikapohon
  - key: document.wanaseta_original.description
    english: A copy of the inscription with the verification team's translation.
      Its ending is broken.
    indonesian: Salinan prasasti beserta terjemahan tim verifikasi. Bagian akhir
      prasasti terbelah.
  - key: document.wanaseta_translation.name
    english: Wanaseta Archive Translation
    indonesian: Terjemahan Arsip Wanaseta
  - key: document.wanaseta_translation.description
    english: A travel account and warning by someone who claims to have stayed in
      the village.
    indonesian: Catatan perjalanan dan peringatan dari seseorang yang mengaku singgah
      di desa tersebut.
  - key: document.field_assignment.name
    english: Field Verification Assignment
    indonesian: Surat Tugas Verifikasi Lapangan
  - key: document.field_assignment.description
    english: Field verification assignment for MC, A, and B.
    indonesian: Tugas verifikasi lapangan untuk MC, A, dan B.
  - key: document.agenda_2026_08_24.name
    english: "Agenda \u2014 24 August 2026"
    indonesian: "Agenda \u2014 24 Agustus 2026"
  - key: document.agenda_2026_08_24.description
    english: A diary entry about the Wanaseta archive assignment.
    indonesian: Catatan agenda mengenai tugas verifikasi arsip Wanaseta.
  - key: document.travel_receipt.name
    english: Payment Receipt
    indonesian: Struk Pembayaran
  - key: document.travel_receipt.description
    english: Proof of supply expenses after the assignment.
    indonesian: Bukti pengeluaran perbekalan setelah penugasan.
  - key: interact.chapter.activity
    english: Interact
    indonesian: Berinteraksi
  - key: interact.chapter.shop
    english: Shop
    indonesian: Belanja
  - key: inventory.purchase_complete
    english: The item and receipt were added to inventory.
    indonesian: Barang dan struk masuk inventory.
  - key: quest.main.morning
    english: Morning Routine
    indonesian: Rutinitas Pagi
  - key: quest.main.morning.enter
    english: Enter the archive office
    indonesian: Masuk ke gedung ANRI
  - key: quest.main.morning.desk
    english: Go to your workstation
    indonesian: Menuju ruang kerja
  - key: quest.optional.breakfast
    english: Morning Breakfast
    indonesian: Sarapan Pagi
  - key: quest.optional.breakfast.eat
    english: Have breakfast before work
    indonesian: Sarapan sebelum bekerja
  - key: interact.chapter.bulletin
    english: Read the notice board
    indonesian: Baca papan pengumuman
  - key: story.quest.travel_spbu
    english: Travel to the fuel station with Raka and Sinta
    indonesian: Menuju SPBU bersama Raka dan Sinta
  - key: document.spbu_receipt.name
    english: "Fuel Station Receipt \u2014 Vehicle Fuel and Supplies"
    indonesian: "Struk SPBU \u2014 Pengisian dan Perbekalan Kendaraan"
  - key: document.spbu_receipt.description
    english: Receipt for filling the vehicle and buying and filling two reserve fuel
      containers.
    indonesian: Bukti pengisian tangki dan pembelian serta pengisian dua jerigen
      cadangan.
  - key: document.spbu_trip_photo.name
    english: "Travel Photo \u2014 Fuel Station Stop"
    indonesian: "Foto Perjalanan \u2014 Persinggahan SPBU"
  - key: document.spbu_trip_photo.description
    english: A photo of MC, A and B in the parking area with the fuel station sign
      behind them.
    indonesian: Foto MC, A dan B di area parkir, dengan papan SPBU di belakang mereka.
  - key: story.quest.spbu_return
    english: Return to the car with Raka and Sinta
    indonesian: Kembali ke mobil bersama Raka dan Sinta
  - key: story.quest.spbu_departure
    english: Leave for Giriawas with Raka and Sinta
    indonesian: Menuju Giriawas bersama Raka dan Sinta
  - key: quest.main.morning.description
    english: Your workday starts at ANRI. Enter the building and go to your desk
      before starting work.
    indonesian: Hari kerja di ANRI dimulai. Masuk ke gedung lalu menuju meja kerja
      untuk memulai rutinitas pagi.
  - key: quest.main.morning.location
    english: 'ANRI: entrance and reception on floor 1; MC and Sinta''s Workroom on
      floor 2.'
    indonesian: 'ANRI: pintu masuk dan resepsionis di lantai 1; Ruang Kerja MC dan
      Sinta di lantai 2.'
  - key: quest.main.rooftop.description
    english: Two coworkers have brought lunch and invited you to eat on the rooftop.
      Meet them and finish the lunch conversation.
    indonesian: Dua rekan kerja membawa makan siang dan mengajakmu makan di rooftop.
      Temui mereka lalu tuntaskan percakapan saat istirahat.
  - key: quest.main.rooftop.location
    english: ANRI rooftop, above floor 4, near the lunch table.
    indonesian: Rooftop ANRI, di atas lantai 4, dekat meja makan saat istirahat.
  - key: quest.main.call.description
    english: Your phone rings as you leave the rooftop. Answer the boss's call to
      hear his request.
    indonesian: Ponsel berdering saat kamu meninggalkan rooftop. Jawab panggilan
      bos untuk mendengar permintaannya.
  - key: quest.main.call.location
    english: ANRI rooftop, near the exit.
    indonesian: Rooftop ANRI, dekat pintu keluar.
  - key: quest.main.boss_first.description
    english: The boss has asked you to discuss a field verification file. Go to his
      office and speak with him.
    indonesian: Bos memanggilmu untuk membahas berkas verifikasi lapangan. Datangi
      ruangannya lalu bicara dengannya.
  - key: quest.main.boss_first.location
    english: 'ANRI, floor 3: Director''s Office. Wait at the double door until you
      are invited in.'
    indonesian: 'ANRI, lantai 3: Ruang Kepala (ruangan bos). Tunggu di pintu ganda
      sampai dipersilakan masuk.'
  - key: quest.main.find.description
    english: The boss needs both field colleagues for the briefing. Find A (Raka)
      and B (Sinta) in either order. Send the first one straight to the boss, then
      find the other.
    indonesian: Bos membutuhkan kedua rekan tim lapangan untuk briefing. Cari A (Raka)
      dan B (Sinta) dalam urutan pilihanmu. Minta rekan pertama langsung menemui
      bos, lalu cari rekan yang satunya.
  - key: quest.main.find.location
    english: 'ANRI, floor 2: Raka is in Raka''s Workroom; Sinta is in MC and Sinta''s
      Workroom. The boss waits on floor 3.'
    indonesian: 'ANRI, lantai 2: Raka berada di Ruang Kerja Raka; Sinta berada di
      Ruang Kerja MC dan Sinta. Bos menunggu di lantai 3.'
  - key: quest.main.escort.description
    english: The first colleague has gone ahead. Accompany the last colleague to
      the boss's office; the conversation follows who you found last.
    indonesian: Rekan pertama sudah berangkat lebih dulu. Dampingi rekan terakhir
      menuju ruangan bos; percakapan mengikuti siapa yang ditemukan terakhir.
  - key: quest.main.escort.location
    english: From the workrooms on ANRI floor 2 to the Director's Office on floor
      3.
    indonesian: Dari ruang kerja di lantai 2 ANRI menuju Ruang Kepala (ruangan bos)
      di lantai 3.
  - key: quest.main.boss_final.description
    english: The team is together. Sit down and listen to the Wanaseta archive briefing.
      Receive the original archive, its translation and the official field assignment.
    indonesian: Tim sudah lengkap. Duduk lalu dengarkan briefing arsip Wanaseta.
      Terima arsip asli, terjemahannya, dan surat tugas verifikasi lapangan.
  - key: quest.main.boss_final.location
    english: 'ANRI, floor 3: Director''s Office, at the briefing seats.'
    indonesian: 'ANRI, lantai 3: Ruang Kepala (ruangan bos), di tempat duduk briefing.'
  - key: quest.main.key.description
    english: The field assignment is ready. Collect the office car key from reception.
      You may finish desk preparations, buy supplies or eat with A and B before collecting
      it.
    indonesian: Tugas lapangan sudah diberikan. Ambil kunci mobil dinas di resepsionis.
      Sebelum mengambilnya, kamu dapat merapikan meja, membeli perbekalan, atau makan
      bersama A dan B.
  - key: quest.main.key.location
    english: 'ANRI, floor 1: reception counter near the main entrance.'
    indonesian: 'ANRI, lantai 1: meja resepsionis dekat pintu masuk utama.'
  - key: quest.main.vehicle.description
    english: You have the car key. Bring the assignment documents to the office car
      and meet A and B before leaving. The seating follows your earlier choice to
      eat together.
    indonesian: Kunci mobil sudah diterima. Bawa berkas tugas ke mobil dinas lalu
      temui A dan B sebelum berangkat. Posisi duduk mengikuti pilihan makan bersama
      sebelumnya.
  - key: quest.main.vehicle.location
    english: 'ANRI parking area: the office car outside the main building.'
    indonesian: 'Area parkir ANRI: mobil dinas di luar gedung utama.'
  - key: story.quest.travel_spbu.description
    english: Leave ANRI with A and B and continue to the fuel station. The team will
      refuel and prepare reserve fuel before continuing the field trip.
    indonesian: Tinggalkan ANRI bersama A dan B lalu lanjutkan perjalanan menuju
      SPBU. Tim akan mengisi bahan bakar dan menyiapkan cadangan sebelum meneruskan
      tugas lapangan.
  - key: story.quest.travel_spbu.location
    english: Road from ANRI to the fuel station; stop at the fuel station entrance.
    indonesian: Jalan dari ANRI menuju SPBU; berhenti di area masuk SPBU.
  - key: story.quest.spbu_return.description
    english: A and B have finished the vehicle preparations and called you back.
      Finish any activity you chose, then return to the parked office car. Extra
      shopping and the park conversation remain optional.
    indonesian: A dan B sudah menuntaskan kebutuhan kendaraan dan memanggilmu kembali.
      Selesaikan kegiatan pilihanmu lalu kembali ke mobil dinas yang terparkir. Belanja
      tambahan dan percakapan di taman tetap opsional.
  - key: story.quest.spbu_return.location
    english: 'Fuel station parking area: the office car beside the shop and park
      access.'
    indonesian: 'Area parkir SPBU: mobil dinas di dekat toko dan akses taman.'
  - key: story.quest.spbu_departure.description
    english: Rejoin A and B at the office car. Use the interaction on its right side
      to continue, finish the team conversation and agree on the next destination
      using only the information you obtained.
    indonesian: Bergabung kembali dengan A dan B di mobil dinas. Gunakan interaksi
      di sisi kanan mobil untuk melanjutkan, tuntaskan percakapan tim, lalu sepakati
      tujuan berikutnya berdasarkan informasi yang sudah kamu peroleh.
  - key: story.quest.spbu_departure.location
    english: 'Fuel station parking area: the right side of the office car, then inside
      the car.'
    indonesian: 'Area parkir SPBU: sisi kanan mobil dinas, kemudian di dalam mobil.'
  - key: quest.optional.breakfast.description
    english: You may stop for breakfast before starting work. Order nasi uduk at
      the canteen and choose whether to pay now or owe the seller.
    indonesian: Kamu dapat sarapan sebelum mulai bekerja. Pesan nasi uduk di kantin
      lalu pilih membayar sekarang atau berutang kepada penjual.
  - key: quest.optional.breakfast.location
    english: 'ANRI, floor 1: canteen counter.'
    indonesian: 'ANRI, lantai 1: meja penjual di kantin.'
  - key: quest.side.wrong_route.description
    english: A coworker has found a file in the wrong active shelf. Deliver it to
      the digitization staff and explain where it was found so they can continue
      scanning.
    indonesian: Seorang pegawai menemukan berkas yang salah masuk rak aktif. Antar
      berkas ke petugas digitalisasi dan jelaskan tempat ditemukannya agar pemindaian
      dapat dilanjutkan.
  - key: quest.side.wrong_route.location
    english: 'ANRI, floor 2: collect the file near the workroom corridor, then deliver
      it to the Document Processing room used by the digitization team scanning desk.'
    indonesian: 'ANRI, lantai 2: terima berkas di dekat koridor ruang kerja, lalu
      antar ke meja pemindaian di ruang Pengolahan Berkas (Tim Digitalisasi).'
  - key: quest.optional.desk_preparation.description
    english: Return to your desk before departure and tidy the documents and personal
      belongings. If you choose to write today's agenda, the dated entry becomes
      a document you can keep.
    indonesian: Kembali ke meja kerja sebelum berangkat lalu rapikan dokumen dan
      barang pribadi. Jika kamu memilih menulis agenda hari ini, catatan bertanggal
      itu menjadi dokumen yang dapat disimpan.
  - key: quest.optional.desk_preparation.location
    english: 'ANRI, floor 2: your desk in MC and Sinta''s Workroom.'
    indonesian: 'ANRI, lantai 2: meja MC di Ruang Kerja MC dan Sinta.'
  - key: quest.optional.supplies.description
    english: Prepare supplies after receiving the field assignment. Visit nearby
      shops and choose what you need; no fixed shopping list is required. Purchases
      produce receipts for your expenses.
    indonesian: Siapkan perbekalan setelah menerima tugas lapangan. Kunjungi toko
      sekitar lalu pilih barang yang dibutuhkan; tidak ada daftar belanja wajib.
      Setiap pembelian menghasilkan struk pengeluaran.
  - key: quest.optional.supplies.location
    english: 'Shops around ANRI: convenience and general stores, electronics shop,
      hardware shop, pharmacy, bookshop and canteen.'
    indonesian: 'Toko di sekitar ANRI: minimarket dan toserba, toko elektronik, material,
      apotek, toko buku, dan kantin.'
  - key: quest.optional.shared_meal.description
    english: Visit the canteen before collecting the office car key. Sit with A (Raka)
      and B (Sinta), then finish the shared meal conversation to complete this optional
      quest.
    indonesian: Datangi kantin sebelum mengambil kunci mobil dinas. Duduk bersama
      A (Raka) dan B (Sinta), lalu tuntaskan percakapan makan bersama untuk menyelesaikan
      quest opsional ini.
  - key: quest.optional.shared_meal.location
    english: 'ANRI, floor 1: the table where Raka and Sinta are eating in the canteen.'
    indonesian: 'ANRI, lantai 1: meja tempat Raka dan Sinta makan di kantin.'
  - key: quest.journal.location_label
    english: Location
    indonesian: Lokasi
  - key: quest.journal.objectives_label
    english: Objectives
    indonesian: Tujuan
  - key: inventory.quest_item_locked
    english: This item is still required by an active quest and cannot be discarded.
    indonesian: Barang ini masih diperlukan untuk misi dan belum bisa dibuang.
  - key: document.wanaseta_original.translation
    english: "TRAVEL ACCOUNT \u2014 RADEN KIAN SANTANG\n\nI stopped in the village
      of Cikapohon at the foot of Mount Cikuray while searching for my father, Prabu
      Siliwangi, who had gone ahead to Sancang.\n\nThe village was beautiful and
      peaceful. I decided to stay for three days before continuing my journey.\n\nThe
      first day. I spent time among the villagers and helped with their work. Each
      night, the village fell silent. That night I woke on a large rock, far from
      where I had rested. I did not know how I had got there. I was overcome by sleepiness
      and fell asleep again.\n\nMorning came. The village was beautiful and peaceful
      again, as though the night had been only a dream. Yet the dream felt too real
      to forget.\n\nThe second day. I had to leave soon. I still had to find my father.
      But my supplies were dwindling too quickly, as though someone took my food
      whenever I was not looking. To keep track, I recorded every meal and activity
      on white cloth with bamboo charcoal.\n\nTonight I read those notes again. My
      writing covered the cloth. It showed that I had been in this village for eight
      days.\n\nThat was impossible. I had only begun writing that morning.\n\nWhatever
      was happening, I had to leave tomorrow.\n\nThe next night I woke among the
      bushes. I could not remember how I had got there. Something was wrong. I ran
      without knowing the way, wanting only to get away from the village.\n\nAs I
      remembered it, I had been here only three days. My notes showed the ninth day.
      My supplies were almost gone. The village seemed to prevent me from leaving.\n\nI
      finally escaped. I was exhausted and nearly out of supplies, but still alive.
      I continued my journey to Sancang.\n\nDo not trust what you see. Do not trust
      what you remember. The demons within this village are very powerful. What appears
      real may not be real. Get out p\u2014\n\n[The inscription is broken. The rest
      of the writing has not been found.]"
    indonesian: "CATATAN PERJALANAN \u2014 RADEN KIAN SANTANG\n\nAku singgah di desa
      Cikapohon di kaki Gunung Cikuray dalam perjalanan mencari ayahku, Prabu Siliwangi,
      yang telah lebih dahulu menuju Sancang.\n\nDesa ini indah dan damai. Karena
      itu, kuputuskan tinggal selama tiga hari sebelum melanjutkan perjalanan.\n\nHari
      pertama. Aku berbaur dengan warga dan membantu pekerjaan mereka. Setiap malam,
      desa menjadi sunyi. Malam itu aku terbangun di atas sebuah batu besar, jauh
      dari tempatku beristirahat. Aku tidak tahu bagaimana sampai di sana. Rasa kantuk
      begitu berat; aku kembali tidur.\n\nPagi datang. Desa kembali indah dan tenang,
      seolah malam tadi hanya mimpi. Namun mimpi itu terasa terlalu nyata untuk kulupakan.\n\nHari
      kedua. Aku harus segera berangkat. Ayahku masih harus kutemukan. Tetapi bekalku
      berkurang terlalu cepat, seakan ada yang mengambil makanan saat aku tidak melihat.
      Agar tidak salah mengingat, kutandai setiap kali makan dan setiap kegiatanku
      dengan arang bambu pada kain putih.\n\nMalam ini kubaca kembali catatan itu.
      Tulisan tanganku memenuhi kain. Catatan tersebut menunjukkan bahwa aku telah
      berada di desa ini selama delapan hari.\n\nIni tidak mungkin. Aku baru mulai
      mencatat pagi tadi.\n\nApa pun yang terjadi, besok aku harus pergi.\n\nMalam
      berikutnya aku terbangun di antara semak-semak. Aku tidak ingat bagaimana sampai
      ke sana. Ada sesuatu yang janggal. Aku berlari tanpa arah, hanya ingin menjauh
      dari desa.\n\nMenurut ingatanku, aku baru berada di sini tiga hari. Catatanku
      menunjukkan hari kesembilan. Bekalku hampir habis. Desa ini seolah mencegahku
      keluar.\n\nAku akhirnya berhasil keluar. Tubuhku lelah, bekalku hampir habis,
      tetapi aku masih hidup. Perjalanan ke Sancang kulanjutkan.\n\nJangan percaya
      pada apa yang kaulihat. Jangan percaya pada apa yang kauingat. Iblis-iblis
      di dalam desa ini sangat kuat. Yang tampak nyata belum tentu nyata. Keluarlah
      p\u2014\n\n[Prasasti terbelah. Kelanjutan tulisan tidak ditemukan.]"
