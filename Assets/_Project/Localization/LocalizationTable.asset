    english: Use
    indonesian: Gunakan
  - key: inventory.action.hold
    english: Hold
    indonesian: Pegang
  - key: inventory.action.release
    english: Release
    indonesian: Lepas
  - key: inventory.action.drop
    english: Drop
    indonesian: Buang
