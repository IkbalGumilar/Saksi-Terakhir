  m_Script: {fileID: 11500000, guid: 46d5044aed1d6471cad6c80b2a45ece0, type: 3}
  m_Name: sinta-last-intro
  m_EditorClassIdentifier: SaksiTerakhir.Runtime::SaksiTerakhir.Story.DialogueSequence
  id: chapter.sinta_last_intro
  lines:
  - speakerId: PLAYER
    text: Sinta, Pak Arya menunggu kita. Raka sudah lebih dulu ke ruangannya.
  - speakerId: NPC-004
    text: Baik. Aku rapikan catatan ini sebentar.
  - speakerId: PLAYER
    text: Kita bisa berangkat?
  - speakerId: NPC-004
    text: Bisa. Sambil jalan, mari bahas rencana liburan setelah tugas ini.
