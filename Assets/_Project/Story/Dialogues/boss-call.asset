  m_Script: {fileID: 11500000, guid: 46d5044aed1d6471cad6c80b2a45ece0, type: 3}
  m_Name: boss-call
  m_EditorClassIdentifier: SaksiTerakhir.Runtime::SaksiTerakhir.Story.DialogueSequence
  id: chapter.boss_call
  lines:
  - speakerId: "PLAYER"
    text: "Halo, Pak. Saya baru selesai makan, masih di rooftop."
  - speakerId: "NPC-006"
    text: "Kalau begitu langsung ke ruangan saya di lantai tiga, Ucup. Ada berkas untuk verifikasi lapangan yang perlu kita bahas."
  - speakerId: "PLAYER"
    text: "Baik, Pak. Saya turun sekarang."
  - speakerId: "NPC-006"
    text: "Saya tunggu. Bawa catatan kalau perlu."
  conditions: []
