  m_Script: {fileID: 11500000, guid: 46d5044aed1d6471cad6c80b2a45ece0, type: 3}
  m_Name: boss-call
  m_EditorClassIdentifier: SaksiTerakhir.Runtime::SaksiTerakhir.Story.DialogueSequence
  id: chapter.boss_call
  lines:
  - speakerId: NPC-006
    text: Halo, ini Arya. Bisa datang ke ruangan saya sekarang?
  - speakerId: PLAYER
    text: Ada yang perlu diperiksa, Pak?
  - speakerId: NPC-006
    text: Ada catatan arsip yang mengganggu pikiran saya. Lebih baik kita bicara
      langsung.
  - speakerId: PLAYER
    text: Saya segera ke sana.
  - speakerId: NPC-006
    text: Terima kasih. Saya menunggu di ruang kerja.
