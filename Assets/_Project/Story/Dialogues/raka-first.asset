  m_Script: {fileID: 11500000, guid: 46d5044aed1d6471cad6c80b2a45ece0, type: 3}
  m_Name: raka-first
  m_EditorClassIdentifier: SaksiTerakhir.Runtime::SaksiTerakhir.Story.DialogueSequence
  id: chapter.raka_first
  lines:
  - speakerId: PLAYER
    text: Pak Bos cari kamu. Katanya sudah telepon juga.
  - speakerId: NPC-003
    text: Oh, HP saya ketinggalan di kantin. Pantas dari tadi tenang sekali.
  - speakerId: PLAYER
    text: Tenangnya pindah ke saya. Sekarang disuruh cari kalian berdua.
  - speakerId: NPC-003
    text: Baik, pencarian saya selesai. Saya langsung ke ruangannya.
  - speakerId: PLAYER
    text: Saya lanjut cari B. Kalau sudah ketemu, kami menyusul.
  conditions: []
