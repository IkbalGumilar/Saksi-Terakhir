  m_Script: {fileID: 11500000, guid: 46d5044aed1d6471cad6c80b2a45ece0, type: 3}
  m_Name: sinta-first
  m_EditorClassIdentifier: SaksiTerakhir.Runtime::SaksiTerakhir.Story.DialogueSequence
  id: chapter.sinta_first
  lines:
  - speakerId: PLAYER
    text: Sinta, Pak Arya memanggil kita ke ruangannya.
  - speakerId: NPC-004
    text: Apakah jadwal akhir pekan berubah?
  - speakerId: PLAYER
    text: Bukan soal liburan. Ada arsip lama yang perlu kita periksa bersama.
  - speakerId: NPC-004
    text: Baik. Aku rapikan meja ini sebentar lalu berangkat.
  - speakerId: PLAYER
    text: Aku harus mencari Raka juga.
  - speakerId: NPC-004
    text: Aku ke ruangan bos lebih dulu. Beri tahu Raka agar tidak berlama-lama.
  - speakerId: PLAYER
    text: Sampai bertemu di lantai empat.
