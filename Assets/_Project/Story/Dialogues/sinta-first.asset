  m_Script: {fileID: 11500000, guid: 46d5044aed1d6471cad6c80b2a45ece0, type: 3}
  m_Name: sinta-first
  m_EditorClassIdentifier: SaksiTerakhir.Runtime::SaksiTerakhir.Story.DialogueSequence
  id: chapter.sinta_first
  lines:
  - speakerId: PLAYER
    text: B, Pak Bos cari kamu. Disuruh langsung ke ruangannya.
  - speakerId: NPC-004
    text: Tiga panggilan tidak terjawab. Aku tadi nggak dengar sama sekali. Oke,
      aku ke sana sekarang.
  - speakerId: PLAYER
    text: Aku masih harus cari A. Kami menyusul.
  - speakerId: NPC-004
    text: Sip. Semoga beliau belum menghitung panggilan keempat.
  conditions: []
