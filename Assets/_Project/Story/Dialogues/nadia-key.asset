  m_Script: {fileID: 11500000, guid: 46d5044aed1d6471cad6c80b2a45ece0, type: 3}
  m_Name: nadia-key
  m_EditorClassIdentifier: SaksiTerakhir.Runtime::SaksiTerakhir.Story.DialogueSequence
  id: chapter.nadia_key
  lines:
  - speakerId: PLAYER
    text: Nadia, Pak Arya meminta kunci mobil kantor.
  - speakerId: NPC-002
    text: Saya sudah menyiapkannya. Mobil hitam terparkir di depan gedung.
  - speakerId: PLAYER
    text: Kami akan memakainya untuk pemeriksaan arsip di lapangan.
  - speakerId: NPC-002
    text: Ini kuncinya. Tolong catat keadaan mobil sebelum berangkat.
  - speakerId: PLAYER
    text: Terima kasih. Saya akan menjaganya.
  - speakerId: NPC-002
    text: Hati-hati di jalan, dan beri kabar jika jadwal kembali berubah.
