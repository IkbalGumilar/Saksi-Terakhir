  m_Script: {fileID: 11500000, guid: 46d5044aed1d6471cad6c80b2a45ece0, type: 3}
  m_Name: breakfast-paid
  m_EditorClassIdentifier: SaksiTerakhir.Runtime::SaksiTerakhir.Story.DialogueSequence
  id: chapter.breakfast_paid
  lines:
  - speakerId: PLAYER
    text: Sekalian saya bayar sekarang, Bu. Nanti sudah duduk di depan komputer,
      susah turun lagi.
  - speakerId: Bu Kantin
    text: Nah, begitu. Tunggu, saya ambil kembaliannya. Jangan sudah jalan baru ingat
      uangnya belum diambil.
  - speakerId: PLAYER
    text: Iya, Bu. Saya masih di sini.
  - speakerId: Bu Kantin
    text: Saya tahu. Biasanya kalian kalau sudah dengar lift bunyi langsung buru-buru.
  conditions: []
