  m_Script: {fileID: 11500000, guid: e351c6e6fe46494987ed5c59a063121c, type: 3}
  m_Name: Arsip_Wanaseta_Original
  m_EditorClassIdentifier: SaksiTerakhir.Runtime::SaksiTerakhir.Inventory.ItemDefinition
  id: document.wanaseta_original
  nameKey: document.wanaseta_original.name
  descriptionKey: document.wanaseta_original.description
  type: 1
  icon: {fileID: 0}
  modelPrefab: {fileID: 0}
  documentText: "\u1B8E\u1B9B\u1BA4\u1B92 \u1B9C\u1B9C\u1B99\u1BAA\u1B95\u1BA0\u1B94\u1BAA
    \u2014 \u1B9B\u1B93\u1BA6\u1B94\u1BAA \u1B8A\u1BA4\u1B83\u1B94\u1BAA \u1B9E\u1B94\u1BAA\u1B92\u1B80\n\n\u1B83\u1B84\u1B80
    \u1B9E\u1BA4\u1B94\u1BAA\u1B93\u1B80 \u1B93\u1BA4 \u1B93\u1BA6\u1B9E \u1B8E\u1BA4\u1B8A\u1B95\u1BA7\u1BA0\u1BA7,
    \u1B93\u1BA4 \u1B9E\u1BA5\u1B8A\u1BA5 \u1B8C\u1BA5\u1B94\u1BA5\u1B80 \u1B8E\u1BA4\u1B8A\u1BA5\u1B9B\u1B9A\u1BAA.
    \u1B83\u1B84\u1B80 \u1B9C\u1BA8\u1B99\u1BAA\u1B95\u1B80 \u1B94\u1BA6\u1B83\u1B8D\u1B94\u1BAA
    \u1B98\u1B95 \u1B83\u1B84\u1B80, \u1B95\u1BAA\u1B9B\u1BA8\u1B98\u1BA5 \u1B9E\u1BA4\u1B9C\u1BA4\u1B9D\u1B8D\u1BA4,
    \u1B94\u1BA5 \u1B92\u1BA4 \u1BA0\u1BA8\u1B9C \u1B9C\u1BA8\u1B99\u1BAA\u1B95\u1B80
    \u1B8A \u1B9E\u1B94\u1BAA\u1B8E\u1B80.\n\n\u1B93\u1BA6\u1B9E \u1B84\u1B94\u1BA4
    \u1B99 \u1B9B\u1B99\u1BAA\u1B95\u1BA6\u1B9E\u1BAA \u1B92\u1BA5\u1B81 \u1B9B\u1BA0\u1B9A\u1BA5.
    \u1B8A\u1BA5 \u1B86\u1B92, \u1B83\u1B84\u1B80 \u1B93\u1BA6\u1BBE \u1B8E\u1BA4\u1B8E\u1BA4\u1B80
    \u1B92\u1BA8\u1B9C\u1BA5 \u1B95\u1BA7\u1B86, \u1B92\u1BA5\u1B9C\u1BA5\u1B9A\u1BAA
    \u1B9C\u1BA8\u1B99\u1BAA\u1B95\u1B80 \u1B93\u1BA8\u1B84.\n\n\u1B95\u1BA7\u1B86
    \u1B8A\u1BA0\u1BA4\u1B8F\u1BA4. \u1B83\u1B84\u1B80 \u1B8D\u1BA0\u1BA4\u1B8F\u1BA4
    \u1B93\u1BA8\u1B80 \u1B85\u1B9B\u1B80 \u1B93\u1BA6\u1B9E, \u1B99\u1B94\u1BAA\u1B92\u1BA5\u1B83\u1B94\u1BAA
    \u1B95\u1B8C\u1B9D\u1BA6\u1B83\u1B94\u1B94. \u1B85\u1B80\u1B8C\u1B9C\u1BAA \u1B95\u1BA8\u1B92\u1BA4\u1B80,
    \u1B93\u1BA6\u1B9E \u1B9E\u1BA8\u1B95\u1BA4. \u1B95\u1BA8\u1B92\u1BA4\u1B80 \u1B86\u1B92
    \u1B83\u1B84\u1B80 \u1BA0\u1BA5\u1B93\u1B80 \u1B93\u1BA4 \u1B9C\u1BA5\u1BA0\u1BA5\u1B81
    \u1B98\u1B92\u1BA5 \u1B8C\u1BA8\u1B93\u1BA6, \u1B8F\u1B85\u1B82 \u1B92\u1BA4
    \u1B95\u1B91\u1B9B\u1BA8\u1B83\u1B94\u1BAA \u1B83\u1B84\u1B80. \u1BA0\u1B94\u1BAA\u1B92\u1BA8
    \u1B91\u1BA0\u1BA7 \u1B8A\u1BA5\u1B99\u1BA0 \u1B94\u1BA8\u1B95\u1BA4 \u1B8A \u1B93\u1BA4\u1B91.
    \u1B92\u1BA5\u1B94\u1BAA\u1B93\u1BA5\u1B82 \u1B83\u1B84\u1B80 \u1B98\u1BA8\u1B9B\u1B92\u1BAA;
    \u1B83\u1B84\u1B80 \u1B9E\u1B9B\u1BA6 \u1B93\u1BA8\u1B84.\n\n\u1B84\u1B9E\u1BA5\u1BBE
    \u1B93\u1B92\u1B80. \u1B93\u1BA6\u1B9E \u1B9B\u1B99\u1BAA\u1B95\u1BA6\u1B9E\u1BAA
    \u1B92\u1BA5\u1B81 \u1B9B\u1BA0\u1B9A\u1BA5 \u1B93\u1BA8\u1B84. \u1B83\u1B84\u1B80
    \u1B91\u1B80\u1B8A \u1B95\u1BA8\u1B92\u1BA4\u1B80 \u1B92\u1B93\u1BA4 \u1B84\u1B99\u1BAA\u1B95\u1BA4\u1B83\u1B94\u1BAA
    \u1B9D\u1BA5\u1B80\u1B8A\u1BA5\u1B9C\u1BAA. \u1B84\u1B99\u1BAA\u1B95\u1BA4\u1B83\u1B94\u1BAA
    \u1B86\u1B92 \u1B8A\u1B9B\u1B9E \u1B91\u1B92, \u1BA0\u1B99\u1BA7 \u1B98\u1BA4\u1B9E
    \u1B93\u1BA4\u1B95\u1BA7\u1B95\u1BA7\u1BA0\u1BA7\u1B8A\u1BA8\u1B94\u1BAA.\n\n\u1B95\u1BA7\u1B86
    \u1B8A\u1B93\u1BA5\u1B83. \u1B83\u1B84\u1B80 \u1B8A\u1BA5\u1B93\u1BA5 \u1B8C\u1BA8\u1B9B
    \u1B9C\u1BA8\u1B99\u1BAA\u1B95\u1B80. \u1B98\u1B95 \u1B83\u1B84\u1B80 \u1B8A\u1BA5\u1B93\u1BA5
    \u1B8A\u1B95\u1B80\u1B8C\u1BA4\u1B82. \u1B98\u1BA8\u1B8A\u1BA8\u1B9C\u1BAA \u1B83\u1B84\u1B80
    \u1B8C\u1B94\u1BAA\u1B8E\u1B80 \u1B9E\u1BA5\u1B9E\u1BA5\u1B92\u1BAA, \u1B8E\u1B9B
    \u1B83\u1B9A \u1B94\u1BA5 \u1B91\u1BA7\u1B8A\u1BA7\u1B92\u1BAA \u1B93\u1BA0\u1B9B\u1BA8\u1B94\u1BAA
    \u1B9C\u1B99\u1BA5\u1B94\u1BAA \u1BA0\u1B94\u1BAA\u1B92\u1BA8 \u1B8A\u1B92\u1BA4\u1B8D\u1B9C\u1BA4
    \u1B8A\u1BA5 \u1B83\u1B84\u1B80. \u1B9E\u1B80\u1B8A\u1B94\u1BAA \u1BA0\u1B94\u1BAA\u1B92\u1BA8
    \u1B9E\u1B9C\u1B82 \u1B84\u1B8D\u1BA8\u1B92\u1BAA, \u1B83\u1B84\u1B80 \u1B94\u1BA5\u1B9C\u1BA4\u1B9E\u1BAA
    \u1B85\u1B80\u1B8C\u1B9C\u1BAA \u1B93\u1BA0\u1B81 \u1B93\u1BA8\u1B80 \u1B9E\u1B8A\u1B98\u1BA6\u1B82
    \u1B95\u1B8C\u1B9D\u1BA6\u1B83\u1B94\u1BAA \u1B83\u1B84\u1B80, \u1B8A\u1BA5 \u1B83\u1B9B\u1BA8\u1B80
    \u1B83\u1B9D\u1BA4 \u1B93\u1BA4\u1B94 \u1B8A\u1B86\u1B94\u1BAA \u1B95\u1BA5\u1B92\u1BA4\u1B82.\n\n\u1B95\u1BA8\u1B92\u1BA4\u1B80
    \u1B84\u1B94\u1BA4 \u1B83\u1B84\u1B80 \u1B99\u1B8E \u1B93\u1BA8\u1B84 \u1B92\u1BA5\u1B9C\u1BA4\u1B9E\u1B94\u1BAA
    \u1B86\u1B92. \u1B8A\u1B86\u1B94\u1BAA \u1B95\u1BA4\u1B94\u1BA5\u1B82 \u1B8A\u1BA5
    \u1B92\u1BA5\u1B9C\u1BA4\u1B9E\u1B94\u1BAA \u1B9C\u1BA8\u1B8D\u1BA8\u1B94\u1BAA
    \u1B83\u1B84\u1B80. \u1B93\u1BA4\u1B94 \u1B92\u1BA5\u1B9C\u1BA4\u1B9E\u1B94\u1BAA
    \u1B86\u1B92, \u1B83\u1B84\u1B80 \u1B83\u1B80\u1B8C\u1BA8\u1B9E\u1BAA \u1B8E\u1BA4\u1B8E\u1BA4\u1B80
    \u1B93\u1BA4 \u1B93\u1BA6\u1B9E \u1B84\u1B94\u1BA4 \u1B93\u1B9C\u1B95\u1B94\u1BAA
    \u1B95\u1BA7\u1B86.\n\n\u1BA0\u1B94\u1BAA\u1B92\u1BA8 \u1B98\u1BA4\u1B9E \u1B8A\u1BA4\u1B92\u1BA5.
    \u1B83\u1B84\u1B80 \u1B8A\u1B8A\u1B9B \u1B94\u1BA5\u1B9C\u1BA4\u1B9E\u1BAA \u1B92\u1B93\u1BA4
    \u1B84\u1B9E\u1BA5\u1BBE.\n\n\u1B94\u1B87\u1B94\u1BAA-\u1B94\u1B87\u1B94\u1BAA
    \u1B94\u1BA5 \u1B8A\u1B8F\u1B93\u1BA4\u1B83\u1B94\u1BAA, \u1B84\u1B9E\u1BA5\u1B8A\u1B94\u1BAA
    \u1B83\u1B84\u1B80 \u1B8A\u1BA5\u1B93\u1BA5 \u1B9C\u1BA8\u1B99\u1BAA\u1B95\u1B80
    \u1B92\u1BA4 \u1B93\u1BA6\u1B9E \u1B84\u1B94\u1BA4.\n\n\u1B95\u1BA8\u1B92\u1BA4\u1B80
    \u1B93\u1BA8\u1B84 \u1B83\u1B84\u1B80 \u1BA0\u1BA5\u1B93\u1B80 \u1B93\u1BA4 \u1B92\u1BA8\u1B8D\u1B82
    \u1B9B\u1BA5\u1B80\u1B8A\u1BA5\u1B94\u1BAA. \u1B83\u1B84\u1B80 \u1BA0\u1B94\u1BAA\u1B92\u1BA8
    \u1B84\u1B8D\u1BA8\u1B92\u1BAA \u1B8A\u1BA5\u1B99\u1BA0 \u1B94\u1BA8\u1B95\u1BA4
    \u1B8A \u1B93\u1BA4\u1B91. \u1B83\u1B9A \u1B94\u1BA5 \u1BA0\u1B94\u1BAA\u1B92\u1BA8
    \u1B99\u1BA8\u1B9B\u1BA8\u1B94\u1B82. \u1B83\u1B84\u1B80 \u1B9C\u1BA5\u1B99\u1BAA\u1B95\u1B92\u1BAA
    \u1BA0\u1B94\u1BAA\u1B92\u1BA8 \u1B95\u1BA5\u1B8C\u1BA5\u1B82 \u1B8F\u1B9C\u1B94\u1BAA,
    \u1BA0\u1B9A\u1B80 \u1B8F\u1B85\u1B82 \u1B92\u1BA4 \u1B93\u1BA6\u1B9E.\n\n\u1B84\u1B8D\u1BA8\u1B92\u1BAA
    \u1B83\u1B84\u1B80 \u1B99 \u1B8A\u1B8A\u1B9B \u1B92\u1BA8\u1B9C\u1BA5 \u1B95\u1BA7\u1B86
    \u1B93\u1BA4 \u1B93\u1BA4\u1B88. \u1B92\u1BA5\u1B9C\u1BA4\u1B9E\u1B94\u1BAA \u1B83\u1B84\u1B80
    \u1B99 \u1B95\u1BA7\u1B86 \u1B8A\u1B9E\u1B9C\u1B95\u1B94\u1BAA. \u1B98\u1BA8\u1B8A\u1BA8\u1B9C\u1BAA
    \u1B83\u1B84\u1B80 \u1B9E\u1B88\u1B92\u1BA4\u1BBE \u1B8A\u1B9B\u1BA4. \u1B93\u1BA6\u1B9E
    \u1B84\u1B94\u1BA4 \u1B8E\u1B9B \u1B94\u1BA0\u1B94\u1BAA \u1B83\u1B84\u1B80,
    \u1BA0\u1B99\u1BA7 \u1B98\u1BA4\u1B9E \u1B8A\u1B9C\u1BA5\u1B83\u1B81.\n\n\u1B83\u1B84\u1B80
    \u1B98\u1BA4\u1B9E \u1B8A\u1B9C\u1BA5\u1B83\u1B81. \u1B83\u1B9D\u1BBE \u1B83\u1B84\u1B80
    \u1B8E\u1B95\u1BA6, \u1B98\u1BA8\u1B8A\u1BA8\u1B9C\u1BAA \u1B9E\u1B88\u1B92\u1BA4\u1BBE
    \u1B8A\u1B9B\u1BA4, \u1B83\u1B84\u1B80 \u1BA0\u1BA4\u1B9B\u1BA5\u1B95\u1BAA \u1B8A\u1BA6\u1B94\u1BA6\u1B82.
    \u1B83\u1B84\u1B80 \u1B8D\u1BA0\u1BA5\u1B9E\u1BA4\u1B81 \u1B8A \u1B9E\u1B94\u1BAA\u1B8E\u1B80.\n\n\u1B99\u1BA5\u1B9C\u1B82
    \u1B95\u1BA8\u1B81\u1B8E\u1B9A \u1B8A\u1B94 \u1B94\u1BA5 \u1B8A\u1B92\u1BA4\u1B8D\u1B9C\u1BA4
    \u1B8A\u1BA5 \u1B9E\u1BA4\u1B83. \u1B99\u1BA5\u1B9C\u1B82 \u1B95\u1BA8\u1B81\u1B8E\u1B9A
    \u1B8A\u1B94 \u1B94\u1BA5 \u1B93\u1BA4\u1B84\u1B8D\u1BA8\u1B92\u1BAA \u1B8A\u1BA5
    \u1B9E\u1BA4\u1B83. \u1B98\u1BA5\u1B92 \u1B9B\u1B8A\u1BAA\u1B9E\u1B9E \u1B93\u1BA4
    \u1B8F\u1BA8\u1B9B\u1BA7 \u1B93\u1BA6\u1B9E \u1B84\u1B94\u1BA4 \u1B9E\u1B8A\u1BAA\u1B92\u1BA4
    \u1B95\u1BA4\u1B9E\u1B94\u1BAA. \u1B94\u1BA5 \u1B8A\u1B92\u1BA4\u1B8D\u1B9C\u1BA4
    \u1B91\u1B92 \u1B99 \u1BA0\u1B94\u1BAA\u1B92\u1BA8 \u1B92\u1B80\u1B92\u1BA5 \u1B91\u1B92.
    \u1B8A\u1B9C\u1BA5\u1B83\u1B81 \u1B95\u1BAA\u2014"
  documentTranslationKey: document.wanaseta_original.translation
  documentFont: {fileID: 11400000, guid: 66bc6d1e538b23324a68bbfef953e53f, type: 2}
