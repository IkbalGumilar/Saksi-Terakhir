# Normalisasi baris. Unity menulis YAML dengan LF.
* text=auto eol=lf

# ---------------------------------------------------------------
# Aset biner — jangan di-diff, jangan dinormalisasi
# ---------------------------------------------------------------
*.png   binary
*.jpg   binary
*.jpeg  binary
*.tga   binary
*.tif   binary
*.tiff  binary
*.psd   binary
*.exr   binary
*.hdr   binary
*.cubemap binary

*.fbx   binary
*.obj   binary
*.blend binary
*.dae   binary
*.3ds   binary

*.wav   binary
*.ogg   binary
*.mp3   binary
*.aif   binary

*.mp4   binary
*.mov   binary
*.webm  binary

*.ttf   binary
*.otf   binary
*.dll   binary
*.so    binary
*.unitypackage binary

# ---------------------------------------------------------------
# Git LFS — BELUM AKTIF
#
# Saat ini Assets/ hanya 332 KB (setting + scene), jadi LFS belum
# perlu. Tapi keputusan ini jauh lebih murah diambil SEKARANG
# daripada nanti: begitu tekstur/model/audio masuk ke history tanpa
# LFS, memindahkannya butuh rewrite history.
#
# Sebelum menambahkan aset art pertama:
#   1. sudo apt install git-lfs && git lfs install
#   2. hapus tanda # pada blok di bawah
#   3. git add .gitattributes && commit
# ---------------------------------------------------------------
# *.png   filter=lfs diff=lfs merge=lfs -text
# *.jpg   filter=lfs diff=lfs merge=lfs -text
# *.psd   filter=lfs diff=lfs merge=lfs -text
# *.tga   filter=lfs diff=lfs merge=lfs -text
# *.exr   filter=lfs diff=lfs merge=lfs -text
# *.fbx   filter=lfs diff=lfs merge=lfs -text
# *.blend filter=lfs diff=lfs merge=lfs -text
# *.wav   filter=lfs diff=lfs merge=lfs -text
