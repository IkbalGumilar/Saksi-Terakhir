# ---------------------------------------------------------------
# Unity generated — jangan pernah di-commit
# Bisa dibangun ulang dari Assets + Packages + ProjectSettings.
# ---------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Meta file aset sumber harus tetap masuk version control.
!/[Aa]ssets/**/*.meta

# ---------------------------------------------------------------
# IDE dan project file yang di-generate Unity
# ---------------------------------------------------------------
.vs/
.vscode/
.idea/
.consulo/
ExportedObj/
/*.csproj
/*.unityproj
/*.sln
/*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
/*.pdb
/*.mdb
*.opendb
*.VC.db

# ---------------------------------------------------------------
# Hasil build di root; artefak dalam Build/ dan Builds/ sudah diabaikan.
# Ekstensi ini tetap diperbolehkan untuk aset atau dependensi proyek.
# ---------------------------------------------------------------
/*.apk
/*.aab
/*.app
/*.unitypackage
/*.x86_64
/sysinfo.txt
/crashlytics-build.properties

# Log dan dump crash Unity/Mono di root.
/*.log
/mono_crash.*
/crash.dmp

# ---------------------------------------------------------------
# Addressables
# ---------------------------------------------------------------
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/addressables_content_state.bin
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/addressables_content_state.bin.meta
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/

# ---------------------------------------------------------------
# Catatan & aturan pribadi — tidak untuk repo publik
# ---------------------------------------------------------------
/note/
/Docs/
/Tools/
# Naskah lokal untuk pembuat dialog; menjaga spoiler di luar repo publik.
/docs/bab-01.md
/docs/bab-01-branch.md
/.agents/
/.aws/
/.codex/
/.superpowers/

# ---------------------------------------------------------------
# Cache Python dan cadangan Blender; sumber .py/.blend tetap tersedia.
# ---------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.blend[0-9]
*.blend[0-9][0-9]
*.blend[0-9].meta
*.blend[0-9][0-9].meta

# ---------------------------------------------------------------
# OS
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
